name: Build Android APK

on:
  push:
    branches: [ main, master ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential git python3-pip ccache libffi-dev libssl-dev python3-dev libxml2-dev libxslt1-dev zlib1g-dev
        pip3 install --upgrade pip
        pip3 install buildozer cython==0.29.36

    - name: Build with Buildozer
      run: |
        buildozer init
        # Прописываем требования прямо в файл конфигурации перед сборкой
        sed -i 's/#requirements = python3,kivy/requirements = python3,kivy,urllib3,certifi,idna,requests,charset-normalizer/g' buildozer.spec
        sed -i 's/#title = My Application/title = Turret Control/g' buildozer.spec
        sed -i 's/#package.name = myapp/package.name = turretcontrol/g' buildozer.spec
        sed -i 's/#package.domain = org.test/package.domain = org.turret/g' buildozer.spec
        
        buildozer -v android debug

    - name: Upload APK artifact
      uses: actions/upload-artifact@v3
      with:
        name: package
        path: bin/*.apk
